<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\ChromaTaskbar.Core\ChromaTaskbar.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>Assets\ChromaTaskbar.ico</ApplicationIcon>
    <RootNamespace>ChromaTaskbar</RootNamespace>
    <AssemblyName>ChromaTaskbar</AssemblyName>
    <AssemblyTitle>ChromaTaskbar</AssemblyTitle>
    <Product>ChromaTaskbar</Product>
    <Description>Adaptive taskbar colour for the foreground maximized application.</Description>
    <GenerateAssemblyCompanyAttribute>false</GenerateAssemblyCompanyAttribute>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Copyright>Copyright (c) 2026</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <None Update="Assets\ChromaTaskbar.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
